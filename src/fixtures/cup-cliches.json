[
  {
    "text": "לגביע חוקים משלו",
    "saidBy": "קלישאת הספורט הישראלית הקלאסית",
    "weight": 100,
    "verified": true,
    "date": null,
    "source": "https://www.one.co.il/Opinion/111134.html"
  },
  {
    "text": "במשחק אחד הכל יכול לקרות",
    "saidBy": "אסי בלדוט, קפטן בני יהודה",
    "weight": 100,
    "verified": true,
    "date": "2010-05",
    "source": "https://sports.walla.co.il/item/1673159"
  },
  {
    "text": "אנחנו באים לנצח, נקודה",
    "saidBy": "גיא לוזון, מאמן בני יהודה",
    "weight": 98,
    "verified": true,
    "date": "2010-05",
    "source": "https://sports.walla.co.il/item/1673159"
  },
  {
    "text": "אין תירוצים להפסד",
    "saidBy": "גיא לוזון, מאמן בני יהודה",
    "weight": 96,
    "verified": true,
    "date": "2010-05",
    "source": "https://sports.walla.co.il/item/1673159"
  },
  {
    "text": "אלה רגעים שחייבים לנצל",
    "saidBy": "אלי גוטמן",
    "weight": 94,
    "verified": true,
    "date": "2010-05",
    "source": "https://sports.walla.co.il/item/1673159"
  },
  {
    "text": "אולי חיפה פייבוריטית, אבל לא הייתי מספיד אותנו",
    "saidBy": "אלי גוטמן, מאמן הפועל תל אביב",
    "weight": 96,
    "verified": true,
    "date": "2011-05-24",
    "source": "https://sports.walla.co.il/item/1826293"
  },
  {
    "text": "אם נזכה בדאבל, ניזכר כאחת הקבוצות הגדולות של המועדון",
    "saidBy": "אלישע לוי, מאמן מכבי חיפה",
    "weight": 84,
    "verified": true,
    "date": "2011-05-24",
    "source": "https://sports.walla.co.il/item/1826293"
  },
  {
    "text": "אם אתה בא מוכן, הכל יכול להיות",
    "saidBy": "מוטי איווניר, מאמן הפועל נוף הגליל",
    "weight": 98,
    "verified": true,
    "date": "2024-04-29",
    "source": "https://www.sport5.co.il/articles.aspx?DocId=468707"
  },
  {
    "text": "זה עולם אחר מלאמן ולשחק בגמר",
    "saidBy": "מוטי איווניר",
    "weight": 78,
    "verified": true,
    "date": "2024-04-29",
    "source": "https://www.sport5.co.il/articles.aspx?DocId=468707"
  },
  {
    "text": "אנחנו לא יודעים מתי נגיע שוב למעמד כזה",
    "saidBy": "מוטי איווניר",
    "weight": 85,
    "verified": true,
    "date": "2024-04-29",
    "source": "https://www.sport5.co.il/articles.aspx?DocId=468707"
  },
  {
    "text": "עצם ההגעה למעמד היא הישג, אבל אנחנו לא מסתפקים בזה",
    "saidBy": "בן שהר, מכבי פתח תקווה",
    "weight": 87,
    "verified": true,
    "date": "2024-04-29",
    "source": "https://www.sport5.co.il/articles.aspx?DocId=468707"
  },
  {
    "text": "נצטרך לעבוד קשה מאוד בכדי להשיג את זה",
    "saidBy": "בן שהר",
    "weight": 84,
    "verified": true,
    "date": "2024-04-29",
    "source": "https://www.sport5.co.il/articles.aspx?DocId=468707"
  },
  {
    "text": "לא מקלים ראש לקראת משחק מאוד קשה",
    "saidBy": "רן קוז'וך, מאמן מכבי פתח תקווה",
    "weight": 88,
    "verified": true,
    "date": "2024-04-29",
    "source": "https://www.sport5.co.il/articles.aspx?DocId=468707"
  },
  {
    "text": "גביע זה מפעל שמעניק הזדמנות שווה לכולם",
    "saidBy": "עודד קטש, מאמן מכבי תל אביב",
    "weight": 95,
    "verified": true,
    "date": "2024-05-15",
    "source": "https://ibasketball.co.il/news/2024/05/"
  },
  {
    "text": "אנחנו צריכים לשמוח שאנחנו זוכים לשחק במעמד כזה",
    "saidBy": "עודד קטש",
    "weight": 85,
    "verified": true,
    "date": "2024-05-15",
    "source": "https://ibasketball.co.il/news/2024/05/"
  },
  {
    "text": "אוי ואבוי אם מישהו מאיתנו יחשוב על המילים בלתי אפשרי",
    "saidBy": "יהוא אורלנד, מאמן בני הרצליה",
    "weight": 91,
    "verified": true,
    "date": "2026-03",
    "source": "https://www.ynet.co.il/sport/israelibasketball/article/s16bykxo11e"
  },
  {
    "text": "כל מאמן מאמין בקבוצה שלו",
    "saidBy": "יהוא אורלנד",
    "weight": 91,
    "verified": true,
    "date": "2026-03",
    "source": "https://www.ynet.co.il/sport/israelibasketball/article/s16bykxo11e"
  },
  {
    "text": "יש לנו רק מה להרוויח מהמשחק הזה",
    "saidBy": "עודד קטש",
    "weight": 96,
    "verified": true,
    "date": "2026-03",
    "source": "https://www.ynet.co.il/sport/israelibasketball/article/s16bykxo11e"
  },
  {
    "text": "התחושות טובות, התרגשות לקראת המשחק",
    "saidBy": "יבגני ברגמן, קפטן הפועל נוף הגליל",
    "weight": 82,
    "verified": true,
    "date": "2024-04-29",
    "source": "https://www.sport5.co.il/articles.aspx?DocId=468707"
  },
  {
    "text": "נעשה הכל בשביל לעלות לגמר",
    "saidBy": "יבגני ברגמן",
    "weight": 96,
    "verified": true,
    "date": "2024-04-29",
    "source": "https://www.sport5.co.il/articles.aspx?DocId=468707"
  },
  {
    "text": "אמא, הבאתי גביע!",
    "saidBy": "פיני גרשון",
    "weight": 100,
    "verified": true,
    "date": "1996",
    "source": "https://www.ynet.co.il/sport/article/one396884"
  },
  {
    "text": "דובון כמוני אוהב קצפת, אבל אני כל כך רוצה את הדובדבן",
    "saidBy": "פיני גרשון",
    "weight": 85,
    "verified": true,
    "date": "1993-05-06",
    "source": "https://he.wikiquote.org/wiki/פיני_גרשון"
  },
  {
    "text": "אנחנו צריכים להיות עיוורים, פיסחים וחרשים כדי לא לזכות באליפות",
    "saidBy": "פיני גרשון",
    "weight": 72,
    "verified": true,
    "date": "1993",
    "source": "https://he.wikiquote.org/wiki/פיני_גרשון"
  },
  {
    "text": "המאמן תמיד צודק, גם כשהוא לא צודק",
    "saidBy": "שלמה שרף",
    "weight": 95,
    "verified": true,
    "date": "1998",
    "source": "https://he.wikiquote.org/wiki/שלמה_שרף"
  },
  {
    "text": "השפיץ של הנעל",
    "saidBy": "שלמה שרף",
    "weight": 87,
    "verified": true,
    "date": null,
    "source": "https://he.wikiquote.org/wiki/שלמה_שרף"
  },
  {
    "text": "מה שחשוב במשחקי הגביע זו לא הדרך. חשובה התוצאה. וזה מה שחשוב",
    "saidBy": "שלמה שרף",
    "weight": 100,
    "verified": true,
    "date": "2011",
    "source": "https://he.wikiquote.org/wiki/שלמה_שרף"
  },
  {
    "text": "איזו הפתעה, איזו הפתעה, איזו הפתעה. אבל תשמע, זאת לא הפתעה",
    "saidBy": "שלמה שרף, בפרשנות להדחה מפתיעה בגביע",
    "weight": 93,
    "verified": true,
    "date": "2008-02-27",
    "source": "https://he.wikiquote.org/wiki/שלמה_שרף"
  },
  {
    "text": "אנחנו לא באים לשמש תפאורה",
    "saidBy": "קלישאת האנדרדוג",
    "weight": 98,
    "verified": false
  },
  {
    "text": "אין פייבוריטית בגביע",
    "saidBy": "כל פרשן לפני הגרלת הגביע",
    "weight": 100,
    "verified": false
  },
  {
    "text": "אנחנו באים לתת 200 אחוז",
    "saidBy": "כל שחקן ישראלי לפני משחק",
    "weight": 99,
    "verified": false
  },
  {
    "text": "הקהל יהיה השחקן ה-12 שלנו",
    "saidBy": "כל קפטן לפני משחק בית",
    "weight": 95,
    "verified": false
  },
  {
    "text": "צריך לבוא עם סכין בין השיניים",
    "saidBy": "קלישאת חדר ההלבשה",
    "weight": 95,
    "verified": false
  },
  {
    "text": "אנחנו מתייחסים למשחק הזה כמו לגמר",
    "saidBy": "כל מאמן לפני משחק גביע",
    "weight": 94,
    "verified": false
  },
  {
    "text": "הכל תלוי בנו",
    "saidBy": "כל מאמן לפני משחק",
    "weight": 93,
    "verified": false
  },
  {
    "text": "מי שרוצה יותר, ינצח",
    "saidBy": "קלישאת מאמנים",
    "weight": 92,
    "verified": false
  },
  {
    "text": "אנחנו באים צנועים אבל מאמינים בעצמנו",
    "saidBy": "כל אנדרדוג לפני משחק",
    "weight": 90,
    "verified": false
  },
  {
    "text": "המשחק הזה יוכרע על הפרטים הקטנים",
    "saidBy": "כל פרשן ספורט",
    "weight": 90,
    "verified": false
  },
  {
    "text": "צריך לבוא מרוכזים מהדקה הראשונה",
    "saidBy": "כל מאמן בישראל",
    "weight": 89,
    "verified": false
  },
  {
    "text": "אנחנו לא מפחדים מאף קבוצה",
    "saidBy": "כל מאמן אנדרדוג",
    "weight": 88,
    "verified": false
  },
  {
    "text": "אין לנו מה להפסיד",
    "saidBy": "כל קבוצה קטנה לפני משחק מול הגדולות",
    "weight": 88,
    "verified": false
  },
  {
    "text": "אנחנו באים לעשות היסטוריה",
    "saidBy": "כל קבוצה קטנה לפני חצי גמר",
    "weight": 87,
    "verified": false
  },
  {
    "text": "הגביע הוא תואר בפני עצמו",
    "saidBy": "כל מנהל מקצועי",
    "weight": 85,
    "verified": false
  },
  {
    "text": "בגביע אין הזדמנות שנייה",
    "saidBy": "כל פרשן",
    "weight": 85,
    "verified": false
  },
  {
    "text": "צריך לדעת לנצח גם משחקים מכוערים",
    "saidBy": "כל מאמן",
    "weight": 83,
    "verified": false
  },
  {
    "text": "ההגנה מנצחת משחקים",
    "saidBy": "כל מאמן כדורסל",
    "weight": 82,
    "verified": false
  },
  {
    "text": "אנחנו צריכים להכתיב את הקצב",
    "saidBy": "כל מאמן כדורסל",
    "weight": 81,
    "verified": false
  },
  {
    "text": "הראש כבר במשחק הבא",
    "saidBy": "כל מאמן אחרי הדחה",
    "weight": 80,
    "verified": false
  },
  {
    "text": "עשינו את כל ההכנות, עכשיו צריך לבצע",
    "saidBy": "כל מאמן לפני משחק",
    "weight": 78,
    "verified": false
  },
  {
    "text": "הגענו עד לכאן בזכות ולא בחסד",
    "saidBy": "כל אנדרדוג לפני גמר",
    "weight": 77,
    "verified": false
  },
  {
    "text": "הכדור לא נכנס, זה חלק מהמשחק",
    "saidBy": "כל מאמן אחרי הפסד",
    "weight": 75,
    "verified": false
  },
  {
    "text": "היו לנו את המצבים, הכדור פשוט לא נכנס",
    "saidBy": "כל מאמן אחרי הדחה",
    "weight": 75,
    "verified": false
  },
  {
    "text": "אנחנו יוצאים עם הרבה דברים חיוביים מהמשחק",
    "saidBy": "כל מאמן אחרי הפסד",
    "weight": 72,
    "verified": false
  },
  {
    "text": "בסוף זוכרים רק את התוצאה",
    "saidBy": "קלישאת מאמנים",
    "weight": 70,
    "verified": false
  },
  {
    "text": "הכל בראש",
    "saidBy": "כל מאמן אחרי הפסד",
    "weight": 68,
    "verified": false
  },
  {
    "text": "לא באנו עד לכאן כדי לעצור עכשיו",
    "saidBy": "כל קפטן לפני גמר",
    "weight": 65,
    "verified": false
  }
]
